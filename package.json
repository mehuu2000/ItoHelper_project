{
  "name": "ito-helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/make-portable.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/build-ui-tests.mjs && node --test tests/*.test.js",
    "lint": "eslint src scripts tests vite.config.js",
    "check": "npm run lint && npm test && npm run build && npm run check:static",
    "check:static": "node scripts/check-static.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.20.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
